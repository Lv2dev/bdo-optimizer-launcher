{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BDO Optimizer",
  "version": "0.3.0",
  "identifier": "com.lv2dev.bdo-optimizer-launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "title": "BDO Optimizer",
        "width": 760,
        "height": 880,
        "minWidth": 720,
        "minHeight": 760,
        "resizable": true,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "assets/app.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh",
        "template": "./windows/installer.nsi"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1QUI2NTg0MjEwQTMwRTAKUldUZ01Bb2hoR1dyNVVYUFdmVmRXa3lPVDB2aVJCZ2JraGJZbnFOYklXNEp2Qk02S01XUXlwSTIK",
      "endpoints": [
        "https://github.com/Lv2dev/bdo-optimizer-launcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
